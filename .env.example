# ───────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your keys for Docker use
# ───────────────────────────────────────────────────────────────────
# Used by docker-compose.yml (env_file) + desktop/docker-entrypoint.sh,
# which turns these into desktop/config.yaml inside the container on
# first start. Same keys/meaning as desktop/config.example.yaml.
#
#   cp .env.example .env
#   docker compose run --rm desktop
# ───────────────────────────────────────────────────────────────────

# "auto" (try online, fall back to offline), "online", or "offline"
MIS_MODE=auto

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI API key from https://platform.openai.com (Whisper STT — not
# used by text mode, which never records audio, but harmless to set)
OPENAI_API_KEY=

# Picovoice Porcupine key (wake word — not used by text mode)
PORCUPINE_ACCESS_KEY=

# Offline model name for Ollama (only relevant if Ollama is reachable
# from inside the container, e.g. via host.docker.internal)
OLLAMA_MODEL=llama3.2
