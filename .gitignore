# ───────────────────────────────────────────────────────────────────
# .gitignore — files that MUST NEVER be committed
# ───────────────────────────────────────────────────────────────────

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.spec
.venv/
venv/

# ── Desktop builds (PyInstaller output) ─────────────────────────
desktop/dist/
desktop/build/

# ── Config with API keys (never commit!) ───────────────────────
desktop/config.yaml
**/config.yaml

# ── Conversation history (local runtime state, may contain
# whatever the user has said to the assistant — never commit) ──
desktop/conversation_history.json

# ── Routines (local user macros — may encode personal habits/
# routines like "unlock the door" — never commit; ship the
# .example.yaml template instead) ──
desktop/routines.yaml

# ── Third-party action plugins (local, user-supplied Python — may
# contain anything from personal automations to accidental secrets;
# never commit. desktop/plugins/examples/ is the documented template
# and stays tracked — everything else directly under desktop/plugins/
# is ignored) ──
desktop/plugins/*
!desktop/plugins/examples/

# ── Android ────────────────────────────────────────────────────
*.iml
.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# ── iOS ────────────────────────────────────────────────────────
*.xcworkspace/
*.xcuserdata/
ios/DerivedData/
ios/Pods/
ios/*.xcodeproj/xcuserdata/
# Swift Package Manager build output (checkouts, build artifacts)
.build/

# ── Generated test-results artifact (see scripts/run_all_tests.sh) ─
test-results/

# ── OS files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDE ─────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Environment / secrets ──────────────────────────────────────
.env
*.env.local

# ── Agent instructions (never commit) ──────────────────────────
AGENTS.md
PROJECT_CHECKLIST.md
